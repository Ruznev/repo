<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:App"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="520"
        x:Class="App.MainWindow" 
        Title="App" WindowStartupLocation="CenterScreen" Background="#990000" 
        FontFamily="Times New Roman" FontSize="13">

     <Window.Styles>
        <Style Selector="DataGridRow.needs-service">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#BF0000"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#990000" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" 
                VerticalAlignment="Center">
                    <Button x:Name="ExitButton" Content="                   Выйти" 
                    Width="180" Height="40" Margin="0,0,10,0" 
                    Background="#994C00" Foreground="White"
                    Click="ExitButton_Click"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="                             Учёт оборудования" FontSize="22" 
                    FontWeight="Bold" VerticalAlignment="Center" 
                    Foreground="White"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DataGrid x:Name="OborudovanieDataGrid" Grid.Row="1" Margin="10"
          AutoGenerateColumns="False" IsReadOnly="True"
          SelectionMode="Single" HeadersVisibility="Column"
          GridLinesVisibility="All" Background="#333333" BorderBrush="#333333" BorderThickness="2"
          RowHeight="32" LoadingRow="OborudovanieDataGrid_LoadingRow">
          <DataGrid.Columns>
            <DataGridTextColumn x:DataType="local:Oborudovanie" Header="Номер" Binding="{Binding Id_Nomer}" Width="100"/>
            <DataGridTextColumn x:DataType="local:Oborudovanie" Header="Наименование" Binding="{Binding Name}" Width="180"/>
            <DataGridTextColumn x:DataType="local:Oborudovanie" Header="Модель" Binding="{Binding Model}" Width="160"/>
            <DataGridTextColumn x:DataType="local:Oborudovanie" Header="Статус" Binding="{Binding Status}" Width="150"/>
            <DataGridTextColumn x:DataType="local:Oborudovanie" Header="История обслуживания" Binding="{Binding Unit}" Width="250"/>
            <DataGridTextColumn x:DataType="local:Oborudovanie" Header="Закрепленный цех" Binding="{Binding ZakrepTsekh}" Width="170"/>
          </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" 
        Margin="10" HorizontalAlignment="Right">
            <Button x:Name="OtchetButton" Content="                   Отчеты" 
            Width="180" Height="40" Margin="0,0,10,0" 
            Background="#994C00" Foreground="White"
                Click="OtchetButton_Click"/>
            <Button x:Name="MaterialButton" Content="                Материалы" 
            Width="180" Height="40" Margin="0,0,10,0" 
            Background="#994C00" Foreground="White"
                Click="MaterialButton_Click"/>
            <Button x:Name="ZaivkaSotrudnikButton" Content="          Заявки и сотрудники" 
            Width="200" Height="40" Margin="0,0,10,0" 
            Background="#994C00" Foreground="White"
                Click="ZaivkaSotrudnikButton_Click"/>
            <Button x:Name="GrafickNormaButton" Content="          Графики и нормативы"
            Width="200" Height="40" Margin="0,0,10,0"
            Background="#994C00" Foreground="White"
                Click="GrafickNormaButton_Click"/>
        </StackPanel>
    </Grid>
</Window>