<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="490" d:DesignHeight="550"
        x:Class="App.AddEditOtchetWindow"
        Title="AddEditOtchetWindow" Background="#990000" 
        WindowStartupLocation="CenterScreen" FontFamily="Times New Roman">

        <Window.Styles>
          <Style Selector="ComboBoxItem">
            <Setter Property="Background" Value="#8C0000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="25,10"/>
          </Style>
          <Style Selector="ComboBoxItem:pointerover">
            <Setter Property="Background" Value="#A60000"/>
          </Style>
          <Style Selector="ComboBoxItem:selected">
            <Setter Property="Background" Value="#A60000"/>
          </Style>
        </Window.Styles>
        <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,5,0,15">
            <TextBlock Text="   Создание/Редактирование отчета" Foreground="White" 
            FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#333333" CornerRadius="4" Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Top" Margin="30,20,30,0">
                  <TextBox x:Name="NomerOtcheta" Tag="Номер отчета" Text="Номер отчета"
                  Height="50" Background="#BF0000" Foreground="White"
                  BorderThickness="0" TextAlignment="Center" FontSize="20" Padding="25,0"
                  VerticalContentAlignment="Center" Margin="0,0,0,16"/>

                  <ComboBox x:Name="PeriodS" PlaceholderText="Период с"
                  Height="50" Background="#BF0000" Foreground="White"
                  BorderThickness="0" FontSize="20" Padding="25,0"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Margin="0,0,0,16">
                    <ComboBoxItem>Январь 2026</ComboBoxItem>
                    <ComboBoxItem>Февраль 2026</ComboBoxItem>
                    <ComboBoxItem>Март 2026</ComboBoxItem>
                    <ComboBoxItem>Апрель 2026</ComboBoxItem>
                    <ComboBoxItem>Май 2026</ComboBoxItem>
                    <ComboBoxItem>Июнь 2026</ComboBoxItem>
                    <ComboBoxItem>Июль 2026</ComboBoxItem>
                    <ComboBoxItem>Август 2026</ComboBoxItem>
                    <ComboBoxItem>Сентябрь 2026</ComboBoxItem>
                    <ComboBoxItem>Октябрь 2026</ComboBoxItem>
                    <ComboBoxItem>Ноябрь 2026</ComboBoxItem>
                    <ComboBoxItem>Декабрь 2026</ComboBoxItem>
                  </ComboBox>
                  
                  <ComboBox x:Name="PeriodDo" PlaceholderText="Период до"
                  Height="50" Background="#BF0000" Foreground="White"
                  BorderThickness="0" FontSize="20" Padding="25,0"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Margin="0,0,0,16">
                    <ComboBoxItem>Январь 2026</ComboBoxItem>
                    <ComboBoxItem>Февраль 2026</ComboBoxItem>
                    <ComboBoxItem>Март 2026</ComboBoxItem>
                    <ComboBoxItem>Апрель 2026</ComboBoxItem>
                    <ComboBoxItem>Май 2026</ComboBoxItem>
                    <ComboBoxItem>Июнь 2026</ComboBoxItem>
                    <ComboBoxItem>Июль 2026</ComboBoxItem>
                    <ComboBoxItem>Август 2026</ComboBoxItem>
                    <ComboBoxItem>Сентябрь 2026</ComboBoxItem>
                    <ComboBoxItem>Октябрь 2026</ComboBoxItem>
                    <ComboBoxItem>Ноябрь 2026</ComboBoxItem>
                    <ComboBoxItem>Декабрь 2026</ComboBoxItem>
                  </ComboBox>

                  <ComboBox x:Name="NomerTsekha" PlaceholderText="Номер цеха"
                  Height="50" Background="#BF0000" Foreground="White"
                  BorderThickness="0" FontSize="20" Padding="25,0"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Margin="0,0,0,16">
                    <ComboBoxItem>Цех №1</ComboBoxItem>
                    <ComboBoxItem>Цех №2</ComboBoxItem>
                    <ComboBoxItem>Цех №3</ComboBoxItem>
                  </ComboBox>

                  <TextBox x:Name="VremyaProstoev" Tag="Общее время простоев" 
                  Text="Общее время простоев" Height="50" Background="#BF0000" 
                  Foreground="White" BorderThickness="0" TextAlignment="Center" 
                  FontSize="20" Padding="25,0" VerticalContentAlignment="Center" 
                  Margin="0,0,0,16"/>
                  
                </StackPanel>

                <Grid Grid.Row="1" Margin="30,10">
                    <Button Content="         Завершить" Width="180" Height="40" x:Name="EndButton"
                     HorizontalAlignment="Center" Background="#994C00" Foreground="White"
                     FontSize="18" BorderThickness="0" Click="EndButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
