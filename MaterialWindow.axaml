<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:App"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="560"
        x:Class="App.MaterialWindow"
        Title="MaterialWindow" WindowStartupLocation="CenterScreen" Background="#990000" 
        FontFamily="Times New Roman" FontSize="13">

        <Window.Styles>
          <Style Selector="DataGridRow">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#BF0000"/>
          </Style>
        </Window.Styles>

        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#990000" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" 
                VerticalAlignment="Center">
                    <Button x:Name="ExitButton" Content="                   Выйти" 
                    Width="180" Height="40" Margin="0,0,10,0" 
                    Background="#994C00" Foreground="White"
                    Click="ExitButton_Click"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="                        Материалы и запасные части" 
                    FontSize="22" FontWeight="Bold" VerticalAlignment="Center" 
                    Foreground="White"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DataGrid x:Name="MaterialDataGrid" Grid.Row="1" Margin="10"
          AutoGenerateColumns="False" IsReadOnly="True"
          SelectionMode="Single" HeadersVisibility="Column"
          GridLinesVisibility="All" Background="#333333"
          BorderBrush="#333333" BorderThickness="2" RowHeight="32">
          <DataGrid.Columns>
            <DataGridTextColumn x:DataType="local:Material" Header="Код" 
            Binding="{Binding Code}" Width="100"/>
            <DataGridTextColumn x:DataType="local:Material" Header="Наименование" 
            Binding="{Binding Name}" Width="200"/>
            <DataGridTextColumn x:DataType="local:Material" Header="Ед. изм." 
            Binding="{Binding Unit}" Width="90"/>
            <DataGridTextColumn x:DataType="local:Material" Header="Остаток" 
            Binding="{Binding Stock, StringFormat={}{0:F2}}" Width="130"/>
            <DataGridTextColumn x:DataType="local:Material" Header="Мин.остаток"
             Binding="{Binding MinStok, StringFormat={}{0:F2}}" Width="120"/>
            <DataGridTextColumn x:DataType="local:Material" Header="Место хранения" 
            Binding="{Binding Sklad}" Width="180"/>
          </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10" 
        HorizontalAlignment="Right">
        <Button x:Name="AddMaterialButton" Content="            Добавить отчет" 
        Width="180" Height="40" Margin="0,0,10,0" Background="#994C00" 
        Foreground="White" Click="AddMaterialButton_Click"/>
        <Button x:Name="EditMaterialButton" Content="           Редактировать отчет" 
        Width="200" Height="40" Margin="0,0,10,0" Background="#994C00" 
        Foreground="White" Click="EditMaterialButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
