<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:App"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="520"
        x:Class="App.ZaivkaSotrudnikWindow"
        Title="ZaivkaSotrudnikWindow" WindowStartupLocation="CenterScreen" Background="#990000" 
        FontFamily="Times New Roman" FontSize="13">

        <Window.Styles>
          <Style Selector="DataGridRow.needs-service">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#BF0000"/>
          </Style>
          <Style Selector="DataGridRow.needs-priority">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#BF0000"/>
          </Style>
        </Window.Styles>

      <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#990000" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" 
                VerticalAlignment="Center">
                    <Button x:Name="ExitButton" Content="                   Выйти" 
                    Width="180" Height="40" Margin="0,0,10,0" 
                    Background="#994C00" Foreground="White"
                    Click="ExitButton_Click"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" 
                VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Content="                 Обновить" 
                    Width="180" Height="40" Margin="0,0,10,0" 
                    Background="#994C00" Foreground="White"
                    Click="RefreshButton_Click"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text=" Заявки и сотрудники" FontSize="22" 
                    FontWeight="Bold" VerticalAlignment="Center" 
                    Foreground="White"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DataGrid x:Name="ZayavkaDataGrid" Grid.Row="1" Margin="10"
          AutoGenerateColumns="False" IsReadOnly="True"
          SelectionMode="Single" HeadersVisibility="Column"
          GridLinesVisibility="All" Background="#333333" BorderBrush="#333333" BorderThickness="2"
          RowHeight="32" LoadingRow="ZayavkaDataGrid_LoadingRow">
          <DataGrid.Columns>
            <DataGridTextColumn x:DataType="local:Zaiavka" Header="Тип заявки" Binding="{Binding Type}" Width="120"/>
            <DataGridTextColumn x:DataType="local:Zaiavka" Header="Приоритет" Binding="{Binding Priority}" Width="170"/>
            <DataGridTextColumn x:DataType="local:Zaiavka" Header="Причина" Binding="{Binding Reason}" Width="160"/>
            <DataGridTextColumn x:DataType="local:Zaiavka" Header="Статус" Binding="{Binding Status}" Width="150"/>
            <DataGridTextColumn x:DataType="local:Zaiavka" Header="Закреплённая бригада" Binding="{Binding Brigada}" Width="250"/>
            <DataGridTextColumn x:DataType="local:Zaiavka" Header="Сотрудники" Binding="{Binding Employees}" Width="180"/>
          </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10" 
        HorizontalAlignment="Right">
        <Button x:Name="AddZayavkaButton" Content="           Добавить заявку" Width="180" 
        Height="40" Margin="0,0,10,0" Background="#994C00" Foreground="White"
        Click="AddZayavkaButton_Click"/>
        <Button x:Name="EditMaterialButton" Content="          Редактировать заявку" Width="200"
        Height="40" Margin="0,0,10,0" Background="#994C00" Foreground="White"
        Click="EditZayavkaButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
